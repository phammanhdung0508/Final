{
  "schema_version": "amazon4u-worker-delegation-policy-v1",
  "status": "USER_APPROVED_PROSPECTIVE_GOVERNANCE_ONLY",
  "documentation": "docs/worker-delegation-policy.md",
  "authority": "data/reports/worker-delegation-governance-v1/authority.txt",
  "default_implementation_channel": "native_agy_worker_invocation",
  "native_mechanism": "delegation_extension",
  "roles": {
    "Pi": ["planning", "orchestration", "task_scoping", "independent_source_and_test_review", "independent_verification", "acceptance_decisions"],
    "native_agy": ["authorized_implementation", "authorized_corrections", "authorized_tests", "related_documentation"],
    "sdk_text_only_generation": "separately_user_approved_exception_untrusted_candidate_not_native_agy"
  },
  "event_types": ["native_agy_worker_invocation", "sdk_text_only_generation_request", "pi_independent_verification"],
  "recovery": {
    "maximum_rounds": 3,
    "maximum_native_invocations_per_round": 2,
    "normal_maximum_native_invocations_per_deliverable": 6,
    "rounds": [
      {"round": 1, "purpose": "initial_implementation", "attempt_numbers": [1, 2], "actions": ["initial_implementation", "consolidated_correction_after_Pi_independent_review"], "if_unresolved": "ESCALATE_1"},
      {"round": 2, "purpose": "targeted_recovery_existing_candidate", "attempt_numbers": [3, 4], "actions": ["targeted_continuation", "consolidated_correction_after_independent_review"], "if_unresolved": "ESCALATE_2"},
      {"round": 3, "purpose": "final_recovery_unresolved_findings", "attempt_numbers": [5, 6], "actions": ["targeted_continuation", "final_consolidated_correction"], "if_unresolved": "ESCALATE_3"}
    ],
    "maximum_not_mandatory": true,
    "blanket_six_call_authorization": false,
    "prospective_task_and_round_authorization_required": true,
    "prospective_scope_time_resource_and_verification_limits_required": true,
    "same_task_candidate_history_and_cumulative_accounting": true,
    "actual_cumulative_count_counts_started_invocations_not_reserved_slots": true,
    "unused_round_slots_neither_count_as_calls_nor_transfer": true,
    "declarative_policy_not_new_runtime_enforcement": true,
    "reset_or_reopen_completed_round_counter": false,
    "unused_slots_authorize_future_rounds": false,
    "started_native_invocations_count_even_if_Pi_orchestration_fails": true,
    "prelaunch_refusal_is_not_fabricated_native_invocation": true,
    "replacement_task_or_task_ID_budget_evasion": false,
    "extension_terminal_revision_reopening_and_heldout_gates_preserved": true,
    "policy_changes_extension_implementation_or_stored_budgets": false,
    "stop_conditions": ["accepted", "no_credible_resolution_path", "authorization_boundary", "critical_safety_issue"]
  },
  "after_each_substantive_escalate": {
    "review_required": true,
    "requirements": ["preserve_candidate_evidence_decisions_consumed_budgets", "substantiate_root_cause", "identify_remaining_acceptance_gaps", "explain_material_next_round_change", "assess_technical_justification_for_further_native_agy_work", "obtain_additional_scope_budget_execution_authority_not_already_granted"],
    "root_cause_categories": ["Worker_implementation", "Pi_handoff_orchestration", "environment_tooling", "verification", "missing_requirements", "other_substantiated_blocker"],
    "Pi_failure_not_equivalent_to_Worker_capability_failure": true,
    "repeated_reports_of_same_decision_increment_escalate_count": false,
    "standing_noncritical_recovery_cannot_expand_existing_authority": true
  },
  "after_third_substantive_escalate": {
    "consolidated_root_cause_assessment_required": true,
    "recommendation_required": true,
    "options": ["stop_task", "propose_separately_authorized_exceptional_native_continuation", "recommend_sdk_text_only_fallback"],
    "recommendation_required_fields": ["evidence", "unresolved_criteria", "justification", "proposed_scope", "proposed_budget", "consequences"],
    "automatic_fallback_execution": false,
    "exceptional_native_over_limit_requires_explicit_user_authorization": true,
    "early_fallback_recommendation_if_native_unavailable_or_serious_safety_issue": true,
    "early_recommendation_grants_execution": false
  },
  "sdk_fallback": {
    "mechanism_retained": true,
    "default": false,
    "explicit_user_approval_before_every_request": true,
    "approval_required_fields": ["why_native_agy_unsuitable_or_unsuccessful", "exact_task_and_unresolved_acceptance_criteria", "SDK_model_and_channel", "allowed_source_and_output_paths", "maximum_SDK_requests", "time_resource_and_verification_limits", "independent_review_and_acceptance_procedure"],
    "request_count_is_ceiling_not_inherited_permission": true,
    "automatic_fallback": false,
    "silent_channel_switch": false,
    "budget_transfer": false,
    "inherited_SDK_authorization": false,
    "SDK_completion_is_native_agy_delegation": false,
    "SDK_generated_code_trusted_without_independent_verification": false,
    "fabricated_native_task_or_verification_receipts": false
  },
  "history": {
    "prospective_only": true,
    "retroactively_authorizes_rounds": false,
    "historical_plans_reports_decisions_counts_evidence_immutable": true,
    "D2_specific_SDK_exception_not_standing_channel_default": true,
    "H_REF_recorded_history": {
      "sdk_text_only_generation_request": 4,
      "native_agy_worker_invocation_in_that_recorded_sequence": 0,
      "sdk_requests_remain_consumed": true,
      "native_rounds_newly_authorized": 0,
      "additional_SDK_requests_authorized": 0,
      "pi_independent_verification_full_dependency_baselines": 1,
      "pi_independent_verification_H_candidate_full_regressions": 0,
      "evidence": ["data/reports/training-harness-h-ref-v1/initial/execution.json", "data/reports/training-harness-h-ref-v1/revision/execution.json", "data/reports/training-harness-h-ref-v1/continuation-v1/implementation/execution.json", "data/reports/training-harness-h-ref-v1/correction-v1/correction/execution.json"],
      "old_generic_Worker_fields_unchanged": true,
      "prior_SDK_decisions_not_mapped_to_native_recovery_rounds": true
    }
  },
  "safeguards": {
    "frozen_methodology_and_evaluation_preserved": true,
    "accepted_models_evaluator_D1_D2_D3_preserved": true,
    "independent_source_test_review_and_original_mandatory_regression_required": true,
    "scope_resource_limits_complete_evidence_preserved": true,
    "criteria_weakening_to_reduce_calls_or_fit_six_attempts": false,
    "implementation_experiments_main_integration_deployment_separate_authority": true,
    "incomplete_mandatory_evaluation_blocks_ACCEPT": true,
    "extension_SDK_controller_source_and_test_changes_authorized_here": false,
    "Worker_or_SDK_requests_authorized_here": false,
    "regression_or_experiment_execution_authorized_here": false,
    "Kaggle_GPU_training_profiling_deployment_authorized_here": false,
    "stage_commit_push_authorized_here": false,
    "deployment_decision": "NOT_AUTHORIZED"
  }
}
